<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa de "Aurora · Reproductor" en el selector de widgets (Android 12 a 14). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:background="@drawable/widget_preview_bg">
    <ImageView android:layout_width="118dp" android:layout_height="118dp" android:src="@drawable/widget_preview_cover" android:importantForAccessibility="no" />
