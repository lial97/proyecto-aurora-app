<?xml version="1.0" encoding="utf-8"?>
<!-- Sin respaldo en la nube ni copia a otro celular: al desinstalar y volver a instalar, Aurora empieza limpia
     (igual que en Windows y Linux). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
